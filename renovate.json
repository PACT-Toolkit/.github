{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 9am on Monday"],
  "labels": ["dependencies"],
  "automerge": false,
  "postUpdateOptions": ["gomodTidy"],
  "customManagers": [
    {
      "description": "Tool pins in a Makefile: a '# renovate:' annotation directly above 'NAME ?= vX.Y.Z'. Only the '?=' form, so repos that declare their own ':=' manager do not get a second PR.",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Makefile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\n[A-Z_]+\\s+\\?=\\s+(?<currentValue>v\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Group all Go dependencies into one PR",
      "matchManagers": ["gomod"],
      "groupName": "Go dependencies"
    },
    {
      "description": "Group Go toolchain bumps",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["toolchain", "golang"],
      "groupName": "Go toolchain"
    },
    {
      "description": "Group all Python dependencies into one PR",
      "matchManagers": ["pip_requirements", "pipenv", "poetry"],
      "groupName": "Python dependencies"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Automerge patch-level Go updates",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Automerge minor and patch npm updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Group TypeScript type definitions",
      "groupName": "TypeScript type definitions",
      "matchPackageNames": ["/^@types//"]
    },
    {
      "description": "Group linting tools",
      "matchPackageNames": [
        "eslint",
        "prettier",
        "@typescript-eslint/{/,}**",
        "@eslint/{/,}**"
      ],
      "groupName": "Linting tools"
    }
  ]
}
